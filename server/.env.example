PORT=8000
# Set this to the shared Redis service URL; required in production.
# REDIS_URL=redis://localhost:6379
# Leave unset unless the deployment uses a known proxy; set only the exact trusted hop count/CIDR.
# TRUST_PROXY=1
# Optional office geofence. If unset, GPS readings are still stored and checked for accuracy/anomalies.
# ATTENDANCE_SITE_LATITUDE=
# ATTENDANCE_SITE_LONGITUDE=
# ATTENDANCE_GEOFENCE_RADIUS_METERS=200
ATTENDANCE_MAX_GPS_ACCURACY_METERS=100
ATTENDANCE_LOCATION_RETENTION_DAYS=90
# Check-ins after this workplace-local time count as late in the admin overview.
ATTENDANCE_LATE_AFTER=09:30
MONGODB_URI=mongodb://localhost:27017/orbit-erp
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-mailbox@gmail.com
SMTP_PASSWORD=your-google-app-password
ORGANIZATION_NAME=Orbit ERP
ORGANIZATION_ADDRESS=
ORGANIZATION_PHONE=
ORGANIZATION_EMAIL=
ORGANIZATION_WEBSITE=
ORGANIZATION_TAX_ID=
SMTP_FROM=Orbit ERP <your-mailbox@gmail.com>
# Set this to the deployed HTTPS frontend origin in production; comma-separate trusted origins.
CLIENT_ORIGIN=http://localhost:5173
